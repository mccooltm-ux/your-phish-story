# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Resend (for email notifications)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Your domain (Vercel will set this automatically, but set for local dev)
DOMAIN=https://myphishistory.com

# Where order notifications go
NOTIFICATION_EMAIL=mccooltm@gmail.com

# Phish.net API key (for username validation + snapshot generation)
PHISHNET_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Order cap — waitlist activates after this many completed orders (default: 20)
ORDER_CAP=20

# Admin panel auth secret
ADMIN_SECRET=your-admin-secret-here

# Vercel cron job auth secret
CRON_SECRET=your-cron-secret-here
